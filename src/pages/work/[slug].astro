---
import Base from '../../layouts/Base.astro';
import { works, profile } from '../../data/works.js';

export function getStaticPaths() {
  return works.map((w, i) => ({ params: { slug: w.slug }, props: { w, i } }));
}

const { w, i } = Astro.props;
const next = works[(i + 1) % works.length];
---
<Base title={`${w.title} · ${profile.name} ${profile.en}`} description={w.sub}>
  <header class="case-top">
    <div class="wrap">
      <a class="back" href="/#work">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 8H3M7 4L3 8l4 4"/></svg>
        返回作品
      </a>
      <h1 class="case-title" data-reveal>{w.title}</h1>
    </div>
  </header>

  {w.shots.length > 0 && (
    <section class="block">
      <div class="wrap">
        <h2 data-reveal>{w.slug === 'ai-workflow' ? '工作流画布' : '数据截图'}</h2>
        <div class={w.slug === 'ai-workflow' ? 'gallery v-stack' : `gallery ${w.shots.length > 1 ? 'g-2' : ''}`}>
          {w.shots.map((s, n) => (
            <figure class="shot" data-reveal={n * 60} style="margin:0">
              {s.src
                ? <a href={s.src} class="zoom" data-lb aria-label={`放大查看：${s.cap || "截图"}`}><img src={s.src} alt={s.cap} loading="lazy" decoding="async" /></a>
                : <div class="box"><div><span class="tag">待上传</span><br />{s.cap}</div></div>}
              {s.cap && <figcaption>{s.cap}</figcaption>}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  {w.videos.length > 0 && (
    <section class="block">
      <div class="wrap">
        <h2 data-reveal>视频</h2>
        <div class={w.slug === 'ai-workflow' ? 'gallery v-stack' : `gallery ${w.videos.length >= 3 ? 'g-3' : w.videos.length === 2 ? 'g-2' : ''}`}>
          {w.videos.map((v, n) => (
            <figure class="shot" data-reveal={n * 60} style="margin:0">
              {v.src
                ? <video src={v.src} poster={v.poster || undefined} controls playsinline preload="none" style="width:100%;display:block;background:#111"></video>
                : <div class="box vbox"><div><span class="tag">待上传</span><br />{v.cap}</div></div>}
              <figcaption>{v.cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <a class="next" href={`/work/${next.slug}/`}>
    <div class="wrap">
      <span class="k">下一个</span>
      <span class="t">{next.title}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
    </div>
  </a>
  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="图片预览" hidden>
    <button class="lb-btn lb-x" type="button" aria-label="关闭">×</button>
    <button class="lb-btn lb-prev" type="button" aria-label="上一张">‹</button>
    <figure class="lb-fig"><img class="lb-img" alt="" /><figcaption class="lb-cap"></figcaption></figure>
    <button class="lb-btn lb-next" type="button" aria-label="下一张">›</button>
  </div>
</Base>

<script>
  const lb = document.getElementById('lb');
  const links = [...document.querySelectorAll('a[data-lb]')];
  if (lb && links.length) {
    const img = lb.querySelector('.lb-img'), cap = lb.querySelector('.lb-cap');
    const prev = lb.querySelector('.lb-prev'), next = lb.querySelector('.lb-next');
    let i = 0, lastFocus = null, sx = 0, sy = 0;
    const show = (n) => {
      i = (n + links.length) % links.length;
      const a = links[i], im = a.querySelector('img');
      img.src = a.getAttribute('href'); img.alt = im?.alt || '';
      const fc = a.closest('figure')?.querySelector('figcaption');
      cap.textContent = fc ? fc.textContent : ''; cap.hidden = !cap.textContent;
    };
    const open = (n) => {
      lastFocus = document.activeElement; show(n);
      lb.hidden = false; requestAnimationFrame(() => lb.classList.add('on'));
      document.documentElement.classList.add('lb-lock'); window.__lenis?.stop();
      lb.querySelector('.lb-x').focus();
    };
    const close = () => {
      lb.classList.remove('on');
      const done = () => { lb.hidden = true; img.removeAttribute('src'); };
      matchMedia('(prefers-reduced-motion: reduce)').matches ? done() : setTimeout(done, 220);
      document.documentElement.classList.remove('lb-lock'); window.__lenis?.start();
      lastFocus?.focus?.();
    };
    const multi = links.length > 1; prev.hidden = next.hidden = !multi;
    links.forEach((a, n) => a.addEventListener('click', (e) => { e.preventDefault(); open(n); }));
    lb.addEventListener('click', (e) => {
      if (e.target.closest('.lb-prev')) return show(i - 1);
      if (e.target.closest('.lb-next')) return show(i + 1);
      if (e.target.closest('.lb-x') || e.target === lb || e.target.classList.contains('lb-fig') || e.target === img) close();
    });
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft' && multi) show(i - 1);
      else if (e.key === 'ArrowRight' && multi) show(i + 1);
    });
    lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
      if (multi && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(i + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .flow{
    list-style:none; margin:0; padding:0;
    display:grid; grid-template-columns:repeat(6, minmax(0,1fr));
    border:1px solid var(--line); background:var(--line); gap:1px;
  }
  .flow li{
    background:var(--bg); padding:20px 16px 22px;
    font-size:14.5px; font-weight:600;
    transition:background .35s var(--ease-out);
  }
  .flow li:hover{ background:var(--accent); }
  .flow .n{
    display:block; margin-bottom:10px;
    font-size:11.5px; font-weight:400; letter-spacing:.12em; color:var(--ink-3);
  }
  .vbox{ aspect-ratio:9/16 !important; }
  .v-stack{ display:flex !important; flex-direction:column; gap:40px; max-width:960px; margin-inline:auto; }
  .v-stack video{ aspect-ratio:16/9; object-fit:contain; }
  .zoom{ display:block; cursor:zoom-in; }
  :global(html.lb-lock), :global(html.lb-lock body){ overflow:hidden; }
  .lb{ position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center;
    background:rgba(250,250,246,.94); backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
    opacity:0; transition:opacity .22s ease; cursor:zoom-out; }
  .lb[hidden]{ display:none; }
  .lb.on{ opacity:1; }
  .lb-fig{ margin:0; display:flex; flex-direction:column; align-items:center; gap:14px; max-width:92vw; }
  .lb-img{ max-width:92vw; max-height:84vh; object-fit:contain; display:block; box-shadow:0 10px 40px rgba(0,0,0,.12);
    transform:scale(.97); transition:transform .22s ease; }
  .lb.on .lb-img{ transform:none; }
  .lb-cap{ font-size:14px; color:var(--ink-2, #333); text-align:center; }
  .lb-btn{ position:absolute; width:48px; height:48px; border-radius:50%; border:1px solid var(--line, #ddd);
    background:#fff; color:#111; font-size:28px; line-height:1; cursor:pointer; display:grid; place-items:center; }
  .lb-btn[hidden]{ display:none; }
  .lb-btn:hover, .lb-btn:focus-visible{ background:var(--accent, #D8FF3E); outline:none; }
  .lb-x{ top:18px; right:18px; }
  .lb-prev{ left:18px; top:50%; translate:0 -50%; }
  .lb-next{ right:18px; top:50%; translate:0 -50%; }
  @media (max-width:640px){ .lb-prev,.lb-next{ top:auto; bottom:18px; translate:none; } .lb-img{ max-height:76vh; } }
  @media (prefers-reduced-motion: reduce){ .lb, .lb-img{ transition:none; } }

  .next{
    display:block; border-top:1px solid var(--line);
    padding-block:clamp(48px,8vw,96px);
    transition:background .45s var(--ease-out);
  }
  .next:hover{ background:var(--accent); }
  .next .k{
    display:block; margin-bottom:10px;
    font-size:12px; letter-spacing:.16em; color:var(--ink-3);
  }
  .next .t{
    display:inline-flex; align-items:center; gap:.4em;
    font-size:clamp(28px,5vw,60px); font-weight:600; letter-spacing:-.025em; line-height:1.1;
  }
  .next .t svg{ width:.6em; height:.6em; transition:transform .45s var(--ease-out); }
  .next:hover .t svg{ transform:translateX(8px); }

  @media (max-width:920px){
    .flow{ grid-template-columns:repeat(3, minmax(0,1fr)); }
  }
  @media (max-width:640px){
    .flow{ grid-template-columns:repeat(2, minmax(0,1fr)); }
    .vbox{ aspect-ratio:4/5 !important; }
  }
</style>
