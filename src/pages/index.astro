---
import Base from '../layouts/Base.astro';
import { works, profile } from '../data/works.js';
import '../styles/work-cards.css';

// 把副标题里的数字拆出来，供滚动计数（无 JS 时照常显示原值）
const NUM_RE = /(\d{1,3}(?:,\d{3})+(?:\.\d+)?|\d+(?:\.\d+)?)/g;
const splitNums = (s) => {
  const parts = String(s).split(NUM_RE).filter((t) => t !== '');
  // 紧跟字母的（如 3C）是名称不是数据，不计数
  return parts.map((t, n) => ({ t, num: /^\d/.test(t) && !/^[A-Za-z]/.test(parts[n + 1] || '') }));
};

const phoneDigits = [...profile.phoneDisplay];
const flowChips = ['选品', '商品卡', '主图', '脚本', 'BD', '复盘'];
