<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(pointer: fine)').matches;
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  const lerp = (a, b, t) => a + (b - a) * t;
  const easeInOut = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  const hero = document.getElementById('top');
  const nav = document.getElementById('nav');
  const cn = document.getElementById('heroCn');
  const en = document.getElementById('heroEn');
  const meta = document.getElementById('heroMeta');
  const desc = document.getElementById('heroDesc');
  const ctas = document.getElementById('heroCtas');
  const cue = document.getElementById('heroScroll');
  const orb = document.getElementById('heroOrb');
  const follow = document.getElementById('heroFollow');
  const jelly = document.getElementById('heroJelly');
  const brandCn = nav?.querySelector('.brand-cn');
  const navDot = nav?.querySelector('.nav-dot');

  /* ---------- 1. 名字 + 绿圆：随滚动收进顶栏 ---------- */
  let m = null; // 量好的静止位置（文档坐标）
  let lastP = -1;
  let fx = 0, fy = 0, fvx = 0, fvy = 0, ftx = 0, fty = 0; // 跟随弹簧

  const work = document.getElementById('work');
  const supportsClip = CSS.supports('overflow', 'clip');
  const dockDistance = (y) => {
    const navH = nav.offsetHeight;
    // 不支持 overflow:clip 的旧浏览器首屏仍会裁切，只能退回到首屏下沿贴住顶栏
    const fallback = hero.offsetHeight - navH - 16;
    if (!work || !supportsClip) return Math.max(220, fallback);
    const headTop = work.getBoundingClientRect().top + y + parseFloat(getComputedStyle(work).paddingTop || '0');
    return Math.max(220, headTop - navH - 32);
  };

  const measure = () => {
    if (!hero || !cn || !orb || !brandCn || !navDot) return;
    cn.style.transform = 'none';
    orb.style.transform = 'none';
    const y = window.scrollY;
    const c = cn.getBoundingClientRect();
    const o = orb.getBoundingClientRect();
    const b = brandCn.getBoundingClientRect();
    const d = navDot.getBoundingClientRect();
    m = {
      cx: c.left + c.width / 2, cy: c.top + c.height / 2 + y, cw: c.width,
      ox: o.left + o.width / 2, oy: o.top + o.height / 2 + y, ow: o.width,
      bx: b.left + b.width / 2, by: b.top + b.height / 2, bw: b.width,
      dx: d.left + d.width / 2, dy: d.top + d.height / 2, dw: d.width,
      // 收进顶栏的那一刻，「作品」标题正好停在顶栏下方 32px
      D: dockDistance(y),
    };
    lastP = -1;
  };

  const render = () => {
    if (!m) return;
    const y = window.scrollY;
    const p = clamp(y / m.D, 0, 1);
    const e = easeInOut(p);
    const docked = p >= 1;

    if (p !== lastP) {
      // 名字
      const sC = Math.exp(Math.log(m.bw / m.cw) * e);
      const tx = (m.bx - m.cx) * e;
      const ty = lerp(m.cy, m.by, e) - (m.cy - y);
      cn.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0) scale(${sC.toFixed(4)})`;
      cn.style.opacity = docked ? '0' : '1';

      // 英文名 / 角色 / 简介 / CTA / 滚动提示先淡出
      const fade = String(clamp(1 - p * 2.2, 0, 1));
      en.style.opacity = fade;
      if (meta) meta.style.opacity = fade;
      if (desc) desc.style.opacity = fade;
      if (ctas) {
        ctas.style.opacity = fade;
        ctas.style.pointerEvents = p > 0.3 ? 'none' : '';
      }
      if (cue) cue.style.opacity = fade;

      nav.classList.toggle('is-docked', docked);
      hero.classList.toggle('is-docked', docked);
      lastP = p;
    }

    // 绿圆（含跟随偏移，越接近顶栏偏移越小）
    const sO = Math.exp(Math.log(m.dw / m.ow) * e);
    const otx = (m.dx - m.ox) * e;
    const oty = lerp(m.oy, m.dy, e) - (m.oy - y);
    orb.style.transform = `translate3d(${otx.toFixed(2)}px, ${oty.toFixed(2)}px, 0) scale(${sO.toFixed(4)})`;
    orb.style.opacity = docked ? '0' : '1';
    const k = 1 - e;
    follow.style.transform = `translate3d(${(fx * k).toFixed(2)}px, ${(fy * k).toFixed(2)}px, 0)`;
  };

  /* ---------- 2. 绿圆跟随：桌面跟鼠标，手机跟倾斜 ---------- */
  const stepSpring = () => {
    // 软弹簧，像液体慢慢滑过去
    fvx = fvx * 0.84 + (ftx - fx) * 0.045;
    fvy = fvy * 0.84 + (fty - fy) * 0.045;
    fx += fvx; fy += fvy;
  };

  let running = false, rafId = 0;
  const loop = () => {
    stepSpring();
    render();
    rafId = running ? requestAnimationFrame(loop) : 0;
  };
  const start = () => { if (!running) { running = true; rafId = requestAnimationFrame(loop); } };
  const stop = () => { running = false; };

  if (!reduce && hero && cn && orb && brandCn && navDot) {
    document.documentElement.classList.add('morph-on');
    measure();
    render();

    // 首屏在视口里才跑动画循环
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) start();
      else { stop(); render(); }
    }).observe(hero);

    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => { measure(); render(); }, 120);
    });
    window.addEventListener('scroll', () => { if (!running) render(); }, { passive: true });
    if (document.fonts?.ready) document.fonts.ready.then(() => { measure(); render(); });
    window.addEventListener('load', () => { measure(); render(); });

    if (fine) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        ftx = ((e.clientX - r.left) / r.width - 0.5) * r.width * 0.14;
        fty = ((e.clientY - r.top) / r.height - 0.5) * r.height * 0.14;
      });
      hero.addEventListener('pointerleave', () => { ftx = 0; fty = 0; });
    }
  }

  // 倾斜
  let tiltOn = false, g0 = null, b0 = null;
  const onTilt = (ev) => {
    if (ev.gamma == null || ev.beta == null) return;
    if (g0 === null) { g0 = ev.gamma; b0 = ev.beta; }
    const w = window.innerWidth, h = hero.offsetHeight;
    ftx = clamp((ev.gamma - g0) / 25, -1, 1) * w * 0.12;
    fty = clamp((ev.beta - b0) / 25, -1, 1) * h * 0.08;
  };
  const enableTilt = () => {
    if (tiltOn || reduce || fine || !('DeviceOrientationEvent' in window)) return;
    tiltOn = true;
    window.addEventListener('deviceorientation', onTilt, { passive: true });
  };
  const needsPermission = typeof window.DeviceOrientationEvent?.requestPermission === 'function';
  if (!needsPermission) enableTilt();

  /* ---------- 3. 点按绿圆：果冻回弹 + 波纹 ---------- */
  if (jelly) {
    jelly.addEventListener('click', (e) => {
      if (needsPermission && !tiltOn && !fine) {
        window.DeviceOrientationEvent.requestPermission()
          .then((s) => { if (s === 'granted') enableTilt(); })
          .catch(() => {});
      }
      if (reduce) return;
      jelly.classList.remove('is-jelly');
      void jelly.offsetWidth;
      jelly.classList.add('is-jelly');

      const r = jelly.getBoundingClientRect();
      const ring = document.createElement('span');
      ring.className = 'ripple';
      const px = r.width ? ((e.clientX - r.left) / r.width) * 100 : 50;
      const py = r.height ? ((e.clientY - r.top) / r.height) * 100 : 50;
      ring.style.left = (e.clientX ? px : 50) + '%';
      ring.style.top = (e.clientY ? py : 50) + '%';
      jelly.appendChild(ring);
      ring.addEventListener('animationend', () => ring.remove());
    });
  }

  /* ---------- 4/5. 卡片进入视口：数字计数 + 荧光笔划线 ---------- */
  const fmtNum = (raw) => {
    const dec = (raw.split('.')[1] || '').length;
    const group = raw.includes(',');
    const f = 10 ** dec;
    return (v) => (Math.round(v * f) / f).toLocaleString('en-US', {
      minimumFractionDigits: dec, maximumFractionDigits: dec, useGrouping: group,
    });
  };

  const countUp = (el) => {
    const raw = el.dataset.num;
    const to = parseFloat(raw.replace(/,/g, ''));
    if (!isFinite(to)) return;
    const fmt = fmtNum(raw);
    const dur = 900 + Math.min(700, String(Math.round(to)).length * 140);
    const t0 = performance.now();
    const tick = (now) => {
      const t = clamp((now - t0) / dur, 0, 1);
      el.textContent = t < 1 ? fmt(to * (1 - Math.pow(1 - t, 3))) : raw;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const rows = [...document.querySelectorAll('.work-row')];
  if (!reduce) {
    rows.forEach((row) => {
      row.querySelectorAll('.num').forEach((el) => {
        // 锁定宽度，避免计数时文字左右跳
        el.style.minWidth = el.getBoundingClientRect().width + 'px';
        el.textContent = fmtNum(el.dataset.num)(0);
      });
    });
  }

  const rowIO = new IntersectionObserver((entries) => {
    entries.forEach((en) => {
      if (!en.isIntersecting) return;
      const row = en.target;
      row.classList.add('is-on');
      if (!reduce) row.querySelectorAll('.num').forEach(countUp);
      rowIO.unobserve(row);
    });
  }, { threshold: 0.45 });
  rows.forEach((r) => rowIO.observe(r));

  // 视频预览：在视口内才播，出视口暂停（省电）
  const vids = [...document.querySelectorAll('.prev-vid')];
  if (vids.length) {
    const vidIO = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        const v = en.target;
        if (en.isIntersecting) {
          const p = v.play();
          if (p && p.catch) p.catch(() => {});
        } else {
          v.pause();
        }
      });
    }, { threshold: 0.35 });
    vids.forEach((v) => {
      if (reduce) { v.removeAttribute('autoplay'); return; }
      vidIO.observe(v);
    });
  }

  /* ---------- 6. 堆叠卡片：后一张盖上来，前一张缩小变暗 ---------- */
  const items = [...document.querySelectorAll('.stack-item')];
  if (!reduce && items.length > 1) {
    let tops = [], pending = false;
    const readTops = () => { tops = items.map((it) => parseFloat(getComputedStyle(it).top) || 0); };
    const stack = () => {
      pending = false;
      for (let i = 0; i < items.length - 1; i++) {
        const next = items[i + 1];
        const h = items[i].offsetHeight || 1;
        const q = clamp(1 - (next.getBoundingClientRect().top - tops[i + 1]) / h, 0, 1);
        const row = rows[i];
        row.style.setProperty('--s', (1 - 0.06 * q).toFixed(4));
        row.style.setProperty('--dim', (0.09 * q).toFixed(3));
      }
    };
    const req = () => { if (!pending) { pending = true; requestAnimationFrame(stack); } };
    readTops(); stack();
    window.addEventListener('scroll', req, { passive: true });
    window.addEventListener('resize', () => { readTops(); req(); });
  }
  /* ---------- 作品卡：进入视口分层冒出 + 轻视差 ---------- */
  {
    const cards = [...document.querySelectorAll('.wk .wcard')];
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cio = new IntersectionObserver((es) => es.forEach((e) => {
      const c = e.target, v = c.querySelector('video');
      if (e.isIntersecting) { c.classList.add('in'); if (v && !rm) v.play().catch(() => {}); }
      else if (v) v.pause();
    }), { threshold: 0.3 });
    cards.forEach((c) => cio.observe(c));
    if (!rm) {
      let t = 0;
      const f = () => { t = 0; const h = innerHeight; cards.forEach((c) => { const r = c.getBoundingClientRect();
        c.style.setProperty('--p', Math.max(-1, Math.min(1, (r.top + r.height / 2 - h / 2) / h)).toFixed(3)); }); };
      addEventListener('scroll', () => { if (!t) t = requestAnimationFrame(f); }, { passive: true }); f();
    }
  }
</script>
